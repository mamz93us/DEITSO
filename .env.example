APP_NAME="IT Solutions Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost
APP_PLATFORM_BASE_DOMAIN=it.deevar.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deitam
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=deitam

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8081
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@it.deevar.cloud"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700

GODADDY_ENV=ote
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_BASE_DOMAIN=it.deevar.cloud

# Caddy on-demand TLS callback (routes/internal.php).
# Generate INTERNAL_ROUTES_TOKEN with `php -r "echo bin2hex(random_bytes(32));"`
# and inject it via Caddy's `header_up X-Internal-Token`. INTERNAL_ALLOWED_IPS
# is a CSV of trusted source IPs; defaults to loopback only.
INTERNAL_ROUTES_TOKEN=
INTERNAL_ALLOWED_IPS=127.0.0.1

# Green API inbound webhook verifier (app/Http/Middleware/VerifyGreenApiSignature.php).
# Use *_SECRET for HMAC-SHA256 mode (when "Sign incoming notifications" is enabled
# in the Green API instance), or *_TOKEN for Bearer mode (URL is the shared secret
# plus a header-level second factor). Generate with the same random_bytes recipe.
GREEN_API_WEBHOOK_SECRET=
GREEN_API_WEBHOOK_TOKEN=

DEFAULT_CURRENCY=EGP

VITE_APP_NAME="${APP_NAME}"
