{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "concat_space": { "spacing": "none" },
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": true,
            "import_functions": false
        },
        "no_unused_imports": true,
        "ordered_imports": { "sort_algorithm": "alpha" },
        "single_line_throw": false
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "node_modules"
    ]
}
